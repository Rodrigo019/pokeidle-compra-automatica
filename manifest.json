{
  "manifest_version": 3,
  "name": "PokeIdle - Compra automática",
  "version": "1.0.0",
  "description": "Repõe sozinho o estoque de pokebolas, poções e revives no Market do NPC do PokeIdle, com reserva de Coins e limite por hora.",
  "homepage_url": "https://github.com/Rodrigo019/pokeidle-compra-automatica",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://pokeidle.io/*", "https://www.pokeidle.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
